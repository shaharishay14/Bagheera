# Colon-separated list of absolute directories the filesystem browser is allowed to traverse.
# Production deployments MUST set this explicitly.
TRIDENT_ALLOWED_ROOTS=/data:/home/researcher

# Path to a checkout of the TRIDENT repo (https://github.com/mahmoodlab/TRIDENT).
# The bash wrapper invokes `python ${TRIDENT_REPO_PATH}/run_batch_of_slides.py ...`.
TRIDENT_REPO_PATH=/path/to/TRIDENT

# Optional: path to the python interpreter that has TRIDENT's deps installed.
# Defaults to `python`.
TRIDENT_PYTHON=python

# Path to a checkout of the PANTHER repo (https://github.com/mahmoodlab/PANTHER).
# The backend runs `python -m training.main_prototype` with cwd=${PANTHER_REPO_PATH}/src.
# ${PANTHER_REPO_PATH}/src/splits/ must be writable by the backend process.
PANTHER_REPO_PATH=/path/to/PANTHER

# SQLite database file (relative paths resolve from the backend working dir).
BAGHEERA_DB_PATH=./bagheera.db

# Optional: override where K-fold split folders are written.
# Defaults to ${PANTHER_REPO_PATH}/src/datasets_splits when PANTHER_REPO_PATH is set.
# DATASETS_SPLITS_ROOT=

# Directory for cached visualization artifacts (heatmaps, top-K grids, UMAPs).
VIZ_CACHE_ROOT=./viz_cache

# Directory for per-inference outputs (TRIDENT features + viz for new WSIs).
INFERENCE_ROOT=./inference_outputs
