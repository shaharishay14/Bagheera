# Bagheera Docker config — copy to `.env` and fill in.
#   cp .env.example .env
# Used by docker-compose.yml for host-path substitution AND passed into the backend
# container (so the in-container *_ROOT paths below must be CONTAINER paths, not host).

# ─────────────────────────────────────────────────────────────────────────────
# Host paths (bind-mounted into the container)
# ─────────────────────────────────────────────────────────────────────────────
# Absolute host directory holding your WSI slides. Mounted read-only at /data.
WSI_DATA_DIR=/absolute/host/path/to/wsi_data
# Absolute host directory for persistent state (DB, caches, outputs, model weights).
# Created on first run; subfolders db/ viz_cache/ inference_outputs/ etc. appear here.
STATE_DIR=/absolute/host/path/to/bagheera_state

# Host port the web UI is served on → open http://localhost:${FRONTEND_PORT}
FRONTEND_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Build args — match these to the GPU box (run `nvidia-smi` to read CUDA version)
# ─────────────────────────────────────────────────────────────────────────────
# Default = CUDA 12.1. For an older driver, use:
#   CUDA_IMAGE=nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04
#   TORCH_INDEX=https://download.pytorch.org/whl/cu118
CUDA_IMAGE=nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04
TORCH_INDEX=https://download.pytorch.org/whl/cu121

# Git refs (branch or tag) to pin the baked-in TRIDENT / PANTHER checkouts.
TRIDENT_REF=main
PANTHER_REF=main

# ─────────────────────────────────────────────────────────────────────────────
# App config (CONTAINER paths — do not change unless you also change the volumes)
# ─────────────────────────────────────────────────────────────────────────────
# Security boundary for the filesystem browser. /data is the mounted WSI dir.
# Add more colon-separated CONTAINER paths if you mount additional roots.
TRIDENT_ALLOWED_ROOTS=/data

BAGHEERA_DB_PATH=/state/db/bagheera.db
VIZ_CACHE_ROOT=/state/viz_cache
INFERENCE_ROOT=/state/inference_outputs
# Override the default (PANTHER repo is baked read-into image) onto a writable volume.
DATASETS_SPLITS_ROOT=/state/datasets_splits

# Which GPU the app uses (index as seen inside the container).
CUDA_VISIBLE_DEVICES=0

# HuggingFace model-weight cache (persisted) + token for gated encoders (e.g. `uni`).
# Leave HF_TOKEN blank if you only use non-gated encoders (e.g. phikon).
HF_HOME=/state/hf_cache
HF_TOKEN=
